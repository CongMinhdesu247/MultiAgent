{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Factory: doctor",
      "type": "process",
      "command": "${input:pythonCommand}",
      "args": ["tools/factory.py", "doctor"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "Factory: init project",
      "type": "process",
      "command": "${input:pythonCommand}",
      "args": ["tools/factory.py", "init", "${input:projectSlug}", "--kind", "${input:projectKind}"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "Factory: verify project",
      "type": "process",
      "command": "${input:pythonCommand}",
      "args": ["tools/factory.py", "verify", "${input:projectSlug}"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Factory: test tooling",
      "type": "process",
      "command": "${input:pythonCommand}",
      "args": ["-m", "unittest", "discover", "-s", "tests", "-v"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": [],
      "group": "test"
    }
  ],
  "inputs": [
    {"id": "pythonCommand", "type": "promptString", "description": "Python 3.11+ executable (python, python3 or absolute path)", "default": "python"},
    {"id": "projectSlug", "type": "promptString", "description": "Project slug under projects/, e.g. my-product"},
    {"id": "projectKind", "type": "pickString", "description": "Product kind", "options": ["web", "mobile", "desktop", "fullstack"], "default": "web"}
  ]
}
